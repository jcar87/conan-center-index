Patch CMakeLists.txt to use the same filenames on Windows as previous versions of the recipe:
- Static library: zlib.lib (MSVC-like) / libz.a (MinGW), no "s" suffix or "d" debug postfix
- Shared library: zlib1.dll, with zdll.lib import library (MSVC-like) / libz.dll.a (MinGW)
  (upstream 1.4 uses libz.dll/libz.lib with MSVC, libzd.dll in Debug)
- Use the zlib1.rc resource file so the DLL version info reports "zlib1.dll"

Dont package the PDB

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 2ccbab9..ca7150a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -233,16 +233,15 @@ set(ZLIB_SRCS
     uncompr.c
     zutil.c)
 
-if(WIN32)
-    set(zlib_static_suffix "s")
-    set(CMAKE_DEBUG_POSTFIX "d")
-endif(WIN32)
+if(WIN32 AND NOT MINGW)
+    set(zlib_static_suffix "lib")
+endif(WIN32 AND NOT MINGW)
 
 if(ZLIB_BUILD_SHARED)
     add_library(
         zlib SHARED ${ZLIB_SRCS} ${ZLIB_PUBLIC_HDRS}
                     ${ZLIB_PRIVATE_HDRS}
-                    $<$<OR:$<BOOL:${WIN32}>,$<BOOL:${CYGWIN}>>:win32/zlib-cmake.rc>
+                    $<$<OR:$<BOOL:${WIN32}>,$<BOOL:${CYGWIN}>>:win32/zlib1.rc>
                     $<$<BOOL:${MSVC}>:${zlib_BINARY_DIR}/zlib.def>)
     add_library(ZLIB::ZLIB ALIAS zlib)
 
@@ -276,11 +275,15 @@ if(ZLIB_BUILD_SHARED)
             EXPORT_NAME ZLIB
             PUBLIC_HEADER "${ZLIB_PUBLIC_HDRS}")
 
-    if(MSVC)
-        set_target_properties(zlib PROPERTIES OUTPUT_NAME libz)
-    else(MSVC)
-        set_target_properties(zlib PROPERTIES OUTPUT_NAME z)
-    endif(MSVC)
+    set_target_properties(zlib PROPERTIES OUTPUT_NAME z)
+    if(WIN32)
+        # always zlib1.dll on Windows (consistency with previous versions of the recipe)
+        set_target_properties(zlib PROPERTIES PREFIX "" RUNTIME_OUTPUT_NAME "zlib1")
+        if(WIN32 AND NOT MINGW)
+            # "zdll.lib" import library for "zlib1.dll" on Windows
+            set_target_properties(zlib PROPERTIES ARCHIVE_OUTPUT_NAME "zdll")
+        endif()
+    endif()
 
     if(UNIX
         AND NOT APPLE
@@ -321,15 +324,9 @@ if(ZLIB_BUILD_STATIC)
         set_target_properties(zlibstatic PROPERTIES PREFIX "lib")
     endif(CYGWIN)
 
-    if(MSVC)
-        set_target_properties(zlibstatic
-            PROPERTIES
-                ARCHIVE_OUTPUT_NAME libz${zlib_static_suffix})
-    else(MSVC)
-        set_target_properties(zlibstatic
-            PROPERTIES
-                ARCHIVE_OUTPUT_NAME z${zlib_static_suffix})
-    endif(MSVC)
+    set_target_properties(zlibstatic
+        PROPERTIES
+            ARCHIVE_OUTPUT_NAME z${zlib_static_suffix})
 
     set_target_properties(zlibstatic
         PROPERTIES
@@ -355,14 +352,14 @@ if(ZLIB_INSTALL)
             NAMESPACE ZLIB::
             DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/zlib)
 
-        if(MSVC)
+        if(0)
             install(
                 FILES $<TARGET_PDB_FILE:zlib>
                 COMPONENT Runtime
                 DESTINATION ${CMAKE_INSTALL_BINDIR}
                 CONFIGURATIONS Debug OR RelWithDebInfo
                 OPTIONAL)
-        endif(MSVC)
+        endif(0)
     endif(ZLIB_BUILD_SHARED)
 
     if(ZLIB_BUILD_STATIC)
